# =======================================================
# GrantFlow Configuration Template
# Copy this file to .env and customize for your environment
# =======================================================

# Server Settings
APP_NAME=GrantFlow
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Security & JWT Tokens
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production_grantflow_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (RDBMS & Azure PostgreSQL)
# Local SQLite fallback for immediate running without setup:
DATABASE_URL=sqlite:///./grantflow.db
# For Azure Database for PostgreSQL Flexible Server, uncomment and fill in:
# DATABASE_URL=postgresql://<admin_user>:<password>@<server-name>.postgres.database.azure.com:5432/<db_name>?sslmode=require

# Azure Blob Storage Configuration (DP-900 Unstructured Store)
# Leave empty to use local disk storage in ./uploads/
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=grantflow-invoices
